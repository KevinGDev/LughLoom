{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lughloom",
  "version": "0.1.0",
  "identifier": "com.lughloom.dev",
  "build": {
    "frontendDist": "../dist/lughloom/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Lughloom",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png"
    ]
  }
}
