{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lughloom",
  "version": "0.1.0",
  "identifier": "com.lughloom.dev",
  "build": {
    "frontendDist": "../dist/lughloom/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Lughloom",
        "width": 1080,
        "height": 1920,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "dmg"],
    "icon": [
      "icons/32x32.ico"
    ],
    "resources": [
      "../dist/lughloom/browser/assets/musics"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
