{
  "$schema": "https://tauri.app/schema/capability/v1",
  "identifier": "default",
  "description": "Default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://localhost:11434/*"
        },
        {
          "url": "http://127.0.0.1:11434/*"
        }
      ]
    },
    {
      "identifier": "http:allow-fetch-send",
      "allow": [
        {
          "url": "http://localhost:11434/*"
        }
      ]
    }
  ]
}
